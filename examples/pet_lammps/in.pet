# STK feasibility check: OPLS-AA PET (6 chains x 4 repeat units) from mBuild + foyer + GMSO
units real
atom_style full
boundary p p p
pair_style lj/cut/coul/long 9.0
pair_modify mix geometric tail yes
bond_style harmonic
angle_style harmonic
dihedral_style opls
special_bonds lj/coul 0.0 0.0 0.5
read_data pet.data
kspace_style pppm 1.0e-4
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press density pe ke etotal
thermo 1000
minimize 1.0e-4 1.0e-6 1000 10000
reset_timestep 0
velocity all create 500.0 4928459 dist gaussian
timestep 1.0
fix 1 all nvt temp 500.0 500.0 100.0
run 5000
unfix 1
# shrink gradually to about 1.2 g/cm3 (a sudden high-pressure NPT from 0.25 g/cm3 loses atoms)
variable side equal lx*(density/1.2)^(1.0/3.0)
variable target equal ${side}
fix 2 all nvt temp 500.0 500.0 100.0
fix 5 all deform 1 x final 0.0 ${target} y final 0.0 ${target} z final 0.0 ${target} remap x
run 30000
unfix 5
unfix 2
fix 6 all npt temp 500.0 500.0 100.0 iso 1.0 1.0 1000.0
run 10000
unfix 6
fix 3 all npt temp 500.0 300.0 100.0 iso 1.0 1.0 1000.0
run 20000
unfix 3
fix 4 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
run 20000
