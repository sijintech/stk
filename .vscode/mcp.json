{
  "servers": {
    "stk-toolkit": {
      "command": "cmd.exe",
      "args": ["/c", "python -m suan.mcp"],
      "cwd": "D:/stk/work/stk",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONLEGACYWINDOWSSTDIO": "1"
      }
    },
      "serena": {
  "command": "serena",
  "args": [
    "start-mcp-server",
    "--context",
    "ide",
    "--project",
    "${workspaceFolder}",
    "--enable-web-dashboard",
    "false",
    "--open-web-dashboard",
    "false"
  ],
  "env": {
    "SERENA_USAGE_REPORTING": "false",
    "STK_TOKEN_PLAN_API_KEY": ""
  }
}
  }
}