[Unit]
Description=STK personal task supervisor
After=network.target

[Service]
Type=simple
ExecStart=/opt/stk/venv/bin/python -m suan.runtime.supervisor --state-dir /local-disk/stk-state
Restart=on-failure
# Workers inherit this environment; MuPRO node settings, see stk-mupro.env.example:
# EnvironmentFile=%h/.config/stk/mupro.env
# Worker lifetimes intentionally outlive dispatcher restarts. Cancel tasks via API.
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
