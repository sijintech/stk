{
 "id": "muferro-domains",
 "name": "muFerro ferroelectric domains",
 "description": "Classify the polarization of one muFerro frame into the 26 cubic variants (stk:cubic-26, STK numbering), draw one smoothed closed surface per variant in its categorical colour with an outline, a legend of the variants present and axes (SimViz domain view), and report the variant fractions and the total-energy trace. Label -1 = unclassified (|P| at or below the threshold) or air, 0 = substrate; both are excluded from the surfaces and from the fraction denominator.",
 "bindings": [{"name": "run", "description": "The muFerro run: a Runtime task or a local run directory."}],
 "graph": {
  "schema": "stk.graph/1",
  "id": "muferro-domains",
  "name": "muFerro ferroelectric domains",
  "description": "Orientation classification (stk:cubic-26) -> per-variant smoothed label surfaces, legend, outline and axes; variant fractions and the energy trace.",
  "catalog": {"stk": 1},
  "parameters": [
   {"name": "step", "type": "step", "default": "latest", "label": "Step"},
   {"name": "min_magnitude", "type": "number", "default": 0.1, "minimum": 0, "label": "|P| threshold",
    "unit": "unspecified",
    "description": "Points with |P| at or below this value are unclassified (-1). Units are the field's (unspecified for muFerro)."},
   {"name": "max_angle_deg", "type": "number", "default": 180, "minimum": 0, "maximum": 180,
    "label": "Max angle (deg)", "description": "Points farther than this from every variant direction are unclassified; 180 accepts all."},
   {"name": "film_detection", "type": "boolean", "default": true, "label": "Film detection",
    "description": "Label unpolarized layers below the film 0 (substrate) and above it -1 (air)."},
   {"name": "smooth_iterations", "type": "integer", "default": 30, "minimum": 0, "maximum": 500,
    "label": "Smoothing iterations"},
   {"name": "view", "type": "enum", "choices": ["iso", "+x", "-x", "+y", "-y", "+z", "-z"], "default": "iso",
    "label": "View"}
  ],
  "nodes": [
   {"id": "run", "type": "stk.source.muferro_run@1", "params": {"binding": "run"}},
   {"id": "polar", "type": "stk.source.muferro_frame@1", "inputs": {"frames": {"from": "run.frames"}},
    "params": {"dataset": "Polar", "step": {"$param": "step"}}},
   {"id": "domains", "type": "stk.analysis.orientation_classify@1", "inputs": {"in": {"from": "polar.out"}},
    "params": {"field": "Polar", "direction_set": "stk:cubic-26", "numbering": "stk",
               "min_magnitude": {"$param": "min_magnitude"}, "max_angle_deg": {"$param": "max_angle_deg"},
               "film_detection": {"$param": "film_detection"}, "output": "domain"}},
   {"id": "surfaces", "type": "stk.filter.label_surfaces@1", "inputs": {"in": {"from": "domains.out"}},
    "params": {"field": "domain", "labels": "present", "exclude": [-1, 0], "smoothing": "windowed_sinc",
               "smooth_iterations": {"$param": "smooth_iterations"}, "smooth_factor": 0.1,
               "compute_normals": true, "close_boundaries": true}},
   {"id": "surface_layer", "type": "stk.render.surface@1", "inputs": {"in": {"from": "surfaces.out"}},
    "params": {"color": {"by": "field", "field": "label"}, "name": "Domains", "shading": "smooth"}},
   {"id": "legend", "type": "stk.render.categorical_legend@1", "inputs": {"source": {"from": "surface_layer.layer"}},
    "params": {"title": "Domain variant", "anchor": "right"}},
   {"id": "box", "type": "stk.render.outline@1", "inputs": {"in": {"from": "polar.out"}}},
   {"id": "axes", "type": "stk.render.axes@1"},
   {"id": "camera", "type": "stk.view.camera@1", "params": {"preset": {"$param": "view"}}},
   {"id": "scene", "type": "stk.view.scene@1",
    "inputs": {"layers": [{"from": "surface_layer.layer"}, {"from": "box.layer"}, {"from": "legend.layer"},
                          {"from": "axes.layer"}],
               "camera": {"from": "camera.camera"}}},
   {"id": "png", "type": "stk.output.image@1", "inputs": {"source": {"from": "scene.scene"}},
    "params": {"width": 1600, "height": 1200}},
   {"id": "fractions", "type": "stk.analysis.label_fractions@1", "inputs": {"in": {"from": "domains.out"}},
    "params": {"field": "domain", "exclude": [-1, 0]}},
   {"id": "energy_plot", "type": "stk.plot.line@1", "inputs": {"table": {"from": "run.energy"}},
    "params": {"x": "step", "y": ["Total Energy"], "y_label": "Total energy (normalized)",
               "title": "Energy trace"}}
  ],
  "outputs": {
   "view": "scene.scene",
   "image": "png.image",
   "fractions": "fractions.out",
   "families": "fractions.families",
   "energy": "energy_plot.plot"
  },
  "ui": {"positions": {"run": [0, 0], "polar": [220, 0], "domains": [440, 0], "surfaces": [660, 0],
                       "surface_layer": [880, 0], "legend": [880, 140], "box": [660, 200], "axes": [880, 280],
                       "camera": [880, 380], "scene": [1100, 100], "png": [1320, 100], "fractions": [660, -160],
                       "energy_plot": [440, -160]}}
 }
}
