{
 "schema": "stk.graph/1",
 "id": "muferro-polarization-isosurface",
 "name": "|P| isosurfaces",
 "description": "Isosurfaces of the polarization magnitude |P| at the given levels, with the grid outline and statistics of |P| so the levels can be chosen from the data (units as reported by the run, usually 'unspecified').",
 "catalog": {"stk": 1},
 "parameters": [
  {"name": "step", "type": "step", "default": "latest", "label": "Step"},
  {"name": "levels", "type": "json", "default": null, "label": "Isovalues of |P| (null = midpoint of the range)"},
  {"name": "view", "type": "enum", "choices": ["iso", "+x", "-x", "+y", "-y", "+z", "-z"], "default": "iso"}
 ],
 "nodes": [
  {"id": "run", "type": "stk.source.muferro_run@1", "params": {"binding": "run"}},
  {"id": "polar", "type": "stk.source.muferro_frame@1", "inputs": {"frames": {"from": "run.frames"}},
   "params": {"dataset": "Polar", "step": {"$param": "step"}}},
  {"id": "magnitude", "type": "stk.filter.calculator@1", "inputs": {"in": {"from": "polar.out"}},
   "params": {"operation": "magnitude", "field": "Polar", "result": "P_magnitude"}},
  {"id": "stats", "type": "stk.analysis.statistics@1", "inputs": {"in": {"from": "magnitude.out"}},
   "params": {"fields": ["P_magnitude"]}},
  {"id": "iso", "type": "stk.filter.contour@1", "inputs": {"in": {"from": "magnitude.out"}},
   "params": {"field": "P_magnitude", "values": {"$param": "levels"}}},
  {"id": "surface", "type": "stk.render.surface@1", "inputs": {"in": {"from": "iso.out"}},
   "params": {"color": {"by": "solid", "solid": [0.85, 0.45, 0.2]}, "opacity": 0.9, "name": "|P| isosurface"}},
  {"id": "box", "type": "stk.render.outline@1", "inputs": {"in": {"from": "polar.out"}}},
  {"id": "axes", "type": "stk.render.axes@1"},
  {"id": "camera", "type": "stk.view.camera@1", "params": {"preset": {"$param": "view"}}},
  {"id": "scene", "type": "stk.view.scene@1",
   "inputs": {"layers": [{"from": "surface.layer"}, {"from": "box.layer"}, {"from": "axes.layer"}],
              "camera": {"from": "camera.camera"}}},
  {"id": "payload", "type": "stk.output.payload@1", "inputs": {"scene": {"from": "scene.scene"}}},
  {"id": "png", "type": "stk.output.image@1", "inputs": {"source": {"from": "scene.scene"}}}
 ],
 "outputs": {"payload": "payload.payload", "image": "png.image", "statistics": "stats.out"}
}
