      "representation": "slice", "colormap": "viridis", "range": "unit", "categorical": false,
      "default_graph": "slice"
    },
    "order_parameter": {
      "label": {"en": "Order parameter", "zh": "序参量"},
      "dimension": {}, "si_unit": "1",
      "tensor": "scalar", "components": 1,
