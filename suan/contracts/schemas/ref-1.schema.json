{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stk:schema:ref-1",
  "title": "STK data reference v1",
  "description": "The only way tools point at data. 'run' names a Runtime task on a node; 'binding' names a caller-resolved binding (the only form allowed inside graphs, with a relative path); 'file' is a desktop-local file (never allowed inside graphs evaluated on compute nodes); 'content' is data pinned in the hub blob store.",
  "type": "object",
  "oneOf": [
    {"required": ["run"]},
    {"required": ["binding"]},
    {"required": ["file"]},
    {"required": ["content"]}
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "node": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "task": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      },
      "additionalProperties": false
    },
    "binding": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "path": {"$ref": "urn:stk:schema:dataset-1#/$defs/relative_path"},
    "file": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "content": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset": {"type": "string"},
    "field": {"type": "string"},
    "frame": {"$ref": "#/$defs/frame_selector"}
  },
  "additionalProperties": false,
  "dependentSchemas": {
    "path": {"required": ["binding"]}
  },
  "$defs": {
    "frame_selector": {
      "type": "object",
      "oneOf": [
        {"required": ["step"], "properties": {"step": {"type": "integer", "minimum": 0}}},
        {"required": ["latest"], "properties": {"latest": {"const": true}}},
        {"required": ["first"], "properties": {"first": {"const": true}}},
        {"required": ["index"], "properties": {"index": {"type": "integer"}}},
        {"required": ["follow"], "properties": {"follow": {"const": "time"}}}
      ],
      "properties": {
        "step": true,
        "latest": true,
        "first": true,
        "index": true,
        "follow": true,
        "policy": {"enum": ["latest_at_or_before", "exact"]}
      },
      "additionalProperties": false
    }
  }
}
