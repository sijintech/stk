{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    ".next",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_root_dirs": [
    "backup",
    "backups",
    "build",
    "cache",
    "coverage",
    "dist",
    "target",
    "tmp",
    "uploads",
    "artifacts",
    "vendor"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 7000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "starter-vendored-static-libs",
        "action": "observe",
        "pattern": "**/static/**/libs/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-lib",
        "action": "observe",
        "pattern": "**/static/**/lib/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 101,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-plugins",
        "action": "observe",
        "pattern": "**/static/**/plugins/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 102,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-js",
        "action": "observe",
        "pattern": "**/*.min.js",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 103,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-css",
        "action": "observe",
        "pattern": "**/*.min.css",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 104,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-source-map",
        "action": "observe",
        "pattern": "**/*.map",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 105,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-fonts",
        "action": "observe",
        "pattern": "**/fonts/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 106,
        "enabled": true
      },
      {
        "rule_id": "stk-archive",
        "action": "observe",
        "pattern": "archive",
        "pattern_kind": "directory",
        "reason": "历史归档不参与活动构建、导入或测试；保留指纹监测并由归档清单描述边界。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-archive-guide",
        "action": "index",
        "pattern": "archive/README.md",
        "pattern_kind": "file",
        "reason": "活动架构依赖此文件解释归档与构建边界。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-archive-manifest",
        "action": "index",
        "pattern": "archive/manifest.json",
        "pattern_kind": "file",
        "reason": "归档模块身份与活动路径映射是维护索引所需的架构证据。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-gui-example-zip",
        "action": "observe",
        "pattern": "suan/gui/examples",
        "pattern_kind": "directory",
        "reason": "此目录为随包示例归档资源，按资产指纹观察，非活动实现。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-gui-icons",
        "action": "observe",
        "pattern": "suan/gui/icons",
        "pattern_kind": "directory",
        "reason": "图标资源按资产指纹观察，调用关系由界面源码描述。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-icon-assets",
        "action": "observe",
        "pattern": "**/*.ico",
        "pattern_kind": "glob",
        "reason": "二进制图标按资产指纹观察。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-local-cursor-config",
        "action": "exclude",
        "pattern": ".cursor",
        "pattern_kind": "directory",
        "reason": "本地Agent连接配置不属于STK产品业务源，避免将连接参数纳入公开索引。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-local-vscode-config",
        "action": "exclude",
        "pattern": ".vscode",
        "pattern_kind": "directory",
        "reason": "本地Agent连接配置不属于STK产品业务源，避免将连接参数纳入公开索引。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-macos-icon",
        "action": "observe",
        "pattern": "**/*.icns",
        "pattern_kind": "glob",
        "reason": "二进制打包图标按资产指纹观察。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-pyregex-generated",
        "action": "observe",
        "pattern": "desktop/engine/lib/stk_io/src/pyregex_tables.inc",
        "pattern_kind": "file",
        "reason": "由测试生成脚本按Python与Unicode版本生成的正则字符表；按生成资产监测指纹，手写匹配器继续索引。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-raster-assets",
        "action": "observe",
        "pattern": "**/*.png",
        "pattern_kind": "glob",
        "reason": "栅格图片按资产指纹观察；不编造代码职责。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-third-party",
        "action": "observe",
        "pattern": "desktop/engine/third_party",
        "pattern_kind": "directory",
        "reason": "第三方原始依赖保留来源与指纹；STK集成边界由活动构建文件和仓库结构文档描述。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-updater-rc",
        "action": "observe",
        "pattern": "suan/gui/Updater/update_image_rc.py",
        "pattern_kind": "file",
        "reason": "Qt资源编译器生成的字节编码；按生成资产观察。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-updater-ui",
        "action": "observe",
        "pattern": "suan/gui/Updater/ui_winUpdate.py",
        "pattern_kind": "file",
        "reason": "Qt UI编译器生成，手写修改会丢失；声明源ui_winUpdate.ui继续索引。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-updater-ui2",
        "action": "observe",
        "pattern": "suan/gui/Updater/ui_winUpdate_ui.py",
        "pattern_kind": "file",
        "reason": "Qt UI编译器生成，手写修改会丢失；声明源ui_winUpdate.ui继续索引。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "stk-vendored-editor",
        "action": "observe",
        "pattern": "suan/gui/pyqode",
        "pattern_kind": "directory",
        "reason": "随包分发的第三方pyqode编辑器实现保留来源和指纹；STK界面适配仍索引。",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
