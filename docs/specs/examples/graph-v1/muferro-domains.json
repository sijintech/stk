{
 "schema": "stk.graph/1",
 "id": "muferro-domains-example",
 "name": "muFerro ferroelectric domains (spec example)",
 "description": "Classify the Polar field into cubic-26 variants, draw one smoothed surface per variant with a legend, outline and axes, and report fractions and the energy trace. The binding 'run' is resolved by the caller.",
 "catalog": {"stk": 1},
 "parameters": [
  {"name": "step", "type": "step", "default": "latest", "label": "Step"},
  {"name": "min_magnitude", "type": "number", "default": 0.1, "minimum": 0, "label": "|P| threshold", "unit": "unspecified"},
  {"name": "view", "type": "enum", "choices": ["iso", "+x", "-x", "+y", "-y", "+z", "-z"], "default": "iso"}
 ],
 "nodes": [
  {"id": "run", "type": "stk.source.muferro_run@1", "params": {"binding": "run"}},
  {"id": "polar", "type": "stk.source.muferro_frame@1",
   "inputs": {"frames": {"from": "run.frames"}},
   "params": {"dataset": "Polar", "step": {"$param": "step"}}},
  {"id": "domains", "type": "stk.analysis.orientation_classify@1",
   "inputs": {"in": {"from": "polar.out"}},
   "params": {"field": "Polar", "direction_set": "stk:cubic-26", "numbering": "stk",
              "min_magnitude": {"$param": "min_magnitude"}, "max_angle_deg": 180, "film_detection": true}},
  {"id": "surfaces", "type": "stk.filter.label_surfaces@1",
   "inputs": {"in": {"from": "domains.out"}},
   "params": {"field": "domain", "exclude": [-1, 0], "smooth_iterations": 30, "smooth_factor": 0.1}},
  {"id": "surface_layer", "type": "stk.render.surface@1",
   "inputs": {"in": {"from": "surfaces.out"}},
   "params": {"color": {"by": "field", "field": "label"}, "name": "Domains"}},
  {"id": "legend", "type": "stk.render.categorical_legend@1",
   "inputs": {"source": {"from": "surface_layer.layer"}},
   "params": {"title": "Domain variant"}},
  {"id": "box", "type": "stk.render.outline@1", "inputs": {"in": {"from": "polar.out"}}},
  {"id": "axes", "type": "stk.render.axes@1"},
  {"id": "camera", "type": "stk.view.camera@1", "params": {"preset": {"$param": "view"}}},
  {"id": "scene", "type": "stk.view.scene@1",
   "inputs": {"layers": [{"from": "surface_layer.layer"}, {"from": "box.layer"}, {"from": "legend.layer"},
                         {"from": "axes.layer"}],
              "camera": {"from": "camera.camera"}}},
  {"id": "payload", "type": "stk.output.payload@1", "inputs": {"scene": {"from": "scene.scene"}},
   "params": {"profile": "web"}},
  {"id": "png", "type": "stk.output.image@1", "inputs": {"source": {"from": "scene.scene"}},
   "params": {"width": 1600, "height": 1200, "magnification": 1}},
  {"id": "fractions", "type": "stk.analysis.label_fractions@1", "inputs": {"in": {"from": "domains.out"}}},
  {"id": "energy_plot", "type": "stk.plot.line@1", "inputs": {"table": {"from": "run.energy"}},
   "params": {"x": "step", "y": ["Total Energy"], "y_label": "Energy (normalized)"}}
 ],
 "outputs": {
  "scene": "scene.scene",
  "payload": "payload.payload",
  "image": "png.image",
  "fractions": "fractions.out",
  "families": "fractions.families",
  "energy_plot": "energy_plot.plot"
 },
 "ui": {"positions": {"run": [0, 0], "polar": [220, 0], "domains": [440, 0], "surfaces": [660, 0]}}
}
